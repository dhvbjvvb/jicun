# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/android/build/
/android/.kotlin/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 签名材料:密钥和口令都不进版本库
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# 上游密钥:只留模板,真值不进版本库
/lib/secrets.dart

# 本地调试产物:截图、录屏、探针日志都不进版本库
/_audit/
/_dl_card/
/_ks/
/_perf_kb/
/_splashfix/
*.mp4
/tool/__pycache__/
__pycache__/

# 美术母本(几千像素的原始插画):只在重新导出素材时用得到,tool/ 下那两个脚本
# 是从命令行收源图的,不读这个目录。留在工作区即可,别跟着仓库走 —— 进过库的三张
# 共 8.5MB,已经用 git rm --cached 摘掉(文件在本目录,历史的旧提交里也还有)。
/_art-src/

# 发人的安装包:几十 MB 的二进制,每次发版重打一份,不进版本库
/dist/

# Windows 桌面端原生实现:只在本机保留,本仓库只发布 Android 端源码
/windows/

# 本地工具目录(放的是本地会话/流程记录,不是项目源码)
/.pi/

# 服务端运维资产(站点域名、服务器路径、证书路径、凭据文件位置、看门狗与定时任务):
# 只在本机保留,不进这个仓库 —— 本仓库是公开的,带上它等于把资产地图发出去。
# 要存档就放私有仓库。
/deploy/

# 清空历史前的本地备份(bundle,含全部旧提交):只在本机,别跟着仓库走
/_repo-backup/

# 交付说明（内部交付记录、真机验收清单）：只在本机留档，不上传
/交付说明.md
